# Salin ke .env lalu sesuaikan. Semua punya default dev yang aman.

# --- Database ---
# Lokal (default): SQLite, zero-setup.
DATABASE_URL=sqlite:///./diel.db
# Produksi/Supabase (contoh): ambil dari Supabase > Project Settings > Database
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# --- Auth ---
# WAJIB ganti di produksi dengan string acak panjang.
SECRET_KEY=dev-secret-change-me
JWT_EXPIRE_MIN=10080

# --- CORS (frontend) ---
CORS_ORIGINS=http://localhost:3000

# --- Batas ---
MAX_BARS=20000
